# Copiar como .env y ajustar antes de levantar docker-compose.
DB_USER=lici_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# El servicio de auth no arranca si ADMIN_SEED_PASSWORD no esta definida
# (a proposito: sin default, para no crear el admin inicial con clave adivinable).
ADMIN_SEED_EMAIL=admin@espe.edu.ec
ADMIN_SEED_PASSWORD=cambiar-esta-clave-antes-de-levantar

FRONTEND_ORIGIN=http://localhost:5173

JWT_EXPIRATION_MINUTES=60
# Llave RSA persistida usada para firmar/validar los JWT (evita invalidar tokens en
# cada reinicio o entre replicas). Generarla una sola vez antes de levantar docker-compose:
#   mkdir -p secrets/jwt
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out secrets/jwt/private_key.pem
# La carpeta secrets/ esta en .gitignore: nunca debe commitearse.
JWT_KEYS_DIR=./secrets/jwt
JWT_KEY_ID=lici-auth-key-1

# Limite de peticiones por IP que aplica el api-gateway a todo el trafico.
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
